        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "quantities": {
          "items": {
            "type": "string"
          },
          "title": "Quantities",
          "type": "array"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "predicate": {
          "$ref": "#/$defs/Predicate"
        },
        "min_methods": {
          "default": 2,
          "title": "Min Methods",
          "type": "integer"
        },
        "needs_verification": {
          "default": true,
          "title": "Needs Verification",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "quantities",
        "unit",
        "predicate"
      ],
      "title": "Metric",
      "type": "object"
    },
    "Override": {
      "additionalProperties": false,
      "description": "One assumption a person changes in a what-if branch.",
      "properties": {
        "quantity": {
          "enum": [
            "spatial_scale",
            "time_base_interval",
            "voltage_offset_s",
            "short_threshold_v",
            "finding_window"
