          "type": "array"
        },
        "folds": {
          "default": [],
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Folds",
          "type": "array"
        },
        "claims": {
          "default": [],
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Claims",
