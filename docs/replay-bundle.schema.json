        "citation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Citation"
        },
        "licence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Licence"
        },
        "author": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Author"
        },
        "scale": {
          "$ref": "#/$defs/SetupFact"
        },
        "clock": {
          "$ref": "#/$defs/SetupFact"
        },
        "voltage": {
          "$ref": "#/$defs/SetupFact"
        },
        "layout": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Layout"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "files": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "title": "Files",
          "type": "object"
        }
      },
      "required": [
        "id",
        "scale",
        "clock",
        "voltage"
      ],
      "title": "ExperimentRecord",
      "type": "object"
    },
    "Fork": {
      "additionalProperties": false,
      "description": "A person's what-if: campaign_id is the new branch, re-examining claim_id of the parent with overrides.\nForks are made by people, never by the agent; the parent's records are never changed.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "campaign_id": {
          "title": "Campaign Id",
          "type": "string"
        },
        "parent_campaign_id": {
          "title": "Parent Campaign Id",
          "type": "string"
        },
        "claim_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Claim Id"
        },
        "author": {
          "title": "Author",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "overrides": {
          "items": {
            "$ref": "#/$defs/Override"
          },
          "title": "Overrides",
          "type": "array"
        },
        "created_at": {
          "title": "Created At",
          "type": "number"
        }
      },
      "required": [
        "id",
        "campaign_id",
        "parent_campaign_id",
        "author",
        "reason",
        "overrides",
        "created_at"
      ],
      "title": "Fork",
      "type": "object"
    },
