            "on",
            "off"
          ],
          "title": "Memory",
          "type": "string"
        },
        "budget_usd": {
          "title": "Budget Usd",
          "type": "number"
        },
        "created_at": {
          "title": "Created At",
          "type": "number"
        }
      },
      "required": [
        "id",
        "objective",
        "title",
        "inputs",
        "budget_usd",
        "created_at"
      ],
      "title": "Campaign",
      "type": "object"
    },
    "Check": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "name",
        "passed",
        "detail"
      ],
      "title": "Check",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "campaign_id": {
          "title": "Campaign Id",
          "type": "string"
        },
        "author": {
          "title": "Author",
          "type": "string"
        },
        "predicate": {
          "$ref": "#/$defs/Predicate"
        },
        "statement": {
          "title": "Statement",
          "type": "string"
        },
        "supersedes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes"
        },
        "created_at": {
          "title": "Created At",
          "type": "number"
        },
        "metric_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Metric Id"
        }
      },
      "required": [
        "id",
        "campaign_id",
        "author",
        "predicate",
        "statement",
        "created_at"
      ],
      "title": "Claim",
      "type": "object"
    },
    "Decision": {
      "additionalProperties": false,
      "description": "The outcome of declaring a winner for one metric; recorded whether it passed or not.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "campaign_id": {
          "title": "Campaign Id",
          "type": "string"
        },
        "metric_id": {
          "title": "Metric Id",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "winner",
            "tie",
            "tradeoff",
            "insufficient_evidence"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "winner_claim_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Winner Claim Id"
        },
        "verification_claim_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verification Claim Id"
        },
        "attempt_claim_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Attempt Claim Ids",
          "type": "array"
        },
        "replication_run_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Replication Run Ids",
          "type": "array"
        },
        "checks": {
          "items": {
            "$ref": "#/$defs/Check"
          },
          "title": "Checks",
          "type": "array"
        },
        "created_at": {
          "title": "Created At",
          "type": "number"
        }
      },
      "required": [
        "id",
        "campaign_id",
        "metric_id",
        "outcome",
        "checks",
        "created_at"
      ],
      "title": "Decision",
      "type": "object"
    },
    "EmbeddedEvidenceFile": {
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "bytes": {
          "title": "Bytes",
          "type": "integer"
        },
        "encoding": {
          "const": "gzip+base64",
          "default": "gzip+base64",
          "title": "Encoding",
          "type": "string"
        },
        "data": {
          "title": "Data",
          "type": "string"
        }
      },
      "required": [
        "sha256",
        "bytes",
        "data"
      ],
      "title": "EmbeddedEvidenceFile",
      "type": "object"
    },
    "Event": {
      "additionalProperties": false,
      "properties": {
        "seq": {
          "title": "Seq",
          "type": "integer"
        },
        "campaign_id": {
          "title": "Campaign Id",
          "type": "string"
        },
        "t": {
          "title": "T",
          "type": "number"
        },
        "type": {
          "enum": [
            "campaign.started",
            "campaign.finished",
            "memory.loaded",
            "memory.learned",
            "step.started",
            "step.finished",
            "tool.started",
            "tool.finished",
            "artifact.created",
            "measurement.recorded",
            "claim.proposed",
            "claim.reviewed",
            "cost.updated",
            "human.note",
            "question.asked",
            "question.answered",
            "question.expired",
            "campaign.control",
            "campaign.paused",
            "campaign.resumed",
            "campaign.retry",
            "fork.created",
            "intervention.recorded",
            "loop.recorded"
          ],
          "title": "Type",
          "type": "string"
        },
        "actor": {
          "title": "Actor",
          "type": "string"
        },
        "title": {
          "maxLength": 90,
          "title": "Title",
          "type": "string"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "refs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Refs",
          "type": "array"
        },
        "data": {
          "additionalProperties": true,
          "default": {},
          "title": "Data",
          "type": "object"
        }
      },
      "required": [
        "seq",
        "campaign_id",
        "t",
        "type",
        "actor",
        "title"
      ],
      "title": "Event",
      "type": "object"
    },
    "ExperimentRecord": {
      "additionalProperties": false,
      "description": "What the lab recorded alongside the video, as the bundle's single description of the experiment.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
