{
  "$defs": {
    "Artifact": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "video",
            "frame",
            "masks",
            "overlay",
            "series",
            "table",
            "code",
            "plot",
            "text",
            "report"
          ],
          "title": "Kind",
          "type": "string"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "bytes": {
          "title": "Bytes",
          "type": "integer"
        },
        "shape": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Shape"
        },
        "axes": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Axes"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/Source"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "transform": {
          "anyOf": [
            {
              "$ref": "#/$defs/Transform"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "created_at": {
          "title": "Created At",
          "type": "number"
        }
      },
      "required": [
        "id",
        "kind",
        "media_type",
        "bytes",
        "created_at"
      ],
      "title": "Artifact",
      "type": "object"
    },
    "Campaign": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "objective": {
          "title": "Objective",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "inputs": {
          "items": {
            "type": "string"
          },
          "title": "Inputs",
          "type": "array"
        },
        "memory": {
          "default": "on",
