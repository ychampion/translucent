{
	admin off
	auto_https off
}

:8080 {
	encode zstd gzip
	handle /api/* {
		request_body {
			max_size 500MB
		}
		# flush at once: campaign updates are a server-sent event stream
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}
	handle {
		root * /srv
		try_files {path} {path}/index.html {path}.html
		file_server
	}
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
